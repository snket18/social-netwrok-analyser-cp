# Base URL of the FastAPI backend API (no trailing slash).
# Example for local development against the FastAPI server:
# VITE_API_URL=http://localhost:8000/api
# Leave unset to use the relative '/api' prefix (same-origin / reverse proxy).
VITE_API_URL=

# Force the development mock backend ('true' or 'false').
# The mock backend is also activated automatically whenever the real
# backend is unreachable, so the frontend stays functional without it.
VITE_MOCK_MODE=false
